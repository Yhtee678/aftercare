{
  "name": "aftercare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:seed": "tsx db/seed.ts",
    "test:workflow": "tsx --test tests/workflow-display.test.ts tests/homework-validation.test.ts tests/care-validation.test.ts tests/dictation-validation.test.ts",
    "test:students": "tsx --test tests/student-validation.test.ts",
    "test:schools": "tsx --test tests/school-validation.test.ts",
    "test:classes": "tsx --test tests/school-class-validation.test.ts",
    "test:homework": "tsx --test tests/homework-validation.test.ts",
    "test:homework:integration": "node --import tsx tests/homework.integration.ts",
    "test:care": "tsx --test tests/care-validation.test.ts",
    "test:care:integration": "node --import tsx tests/care.integration.ts",
    "test:today": "node --import tsx tests/today.integration.ts",
    "test:dictation": "tsx --test tests/dictation-validation.test.ts",
    "test:dictation:integration": "node --import tsx tests/dictation.integration.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
